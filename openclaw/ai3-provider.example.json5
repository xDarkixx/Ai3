// Copy the ai3 provider into your OpenClaw config.
// Replace YOUR_AI3_TOKEN and YOUR_MODEL with values from AI3.
// OpenClaw supports custom OpenAI-compatible providers via models.providers.
{
  models: {
    mode: "merge",
    providers: {
      ai3: {
        baseUrl: "http://127.0.0.1:8080/v1",
        apiKey: "YOUR_AI3_TOKEN",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "YOUR_MODEL",
            name: "AI3 Local Model",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192
          }
        ]
      }
    }
  },
  agents: {
    defaults: {
      model: { primary: "ai3/YOUR_MODEL" }
    }
  }
}
