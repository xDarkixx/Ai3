# AI3 — vollständig selbst gehosteter Beispielbetrieb
# Keine kostenpflichtige KI-API und kein externer KYC-/SMTP-Anbieter erforderlich.
# Eigene Hardware/Strom/Internet bleiben natürlich eigene Kosten.
AI3_ADMIN_KEY=replace-with-a-long-random-admin-key
AI3_ADMIN_PASSWORD=replace-with-a-strong-password
AI3_ADMIN_SESSION_HOURS=12
AI3_DOMAIN=localhost
AI3_PUBLIC_BASE_URL=
AI3_PUBLIC_REGISTRATION=1
AI3_PRIVACY_MODE=1
AI3_ENABLE_ADVANCED_SECURITY=1
AI3_ACCESS_TOKEN_MINUTES=15
AI3_REFRESH_TOKEN_DAYS=30
AI3_RATE_LIMIT_RPM=0
AI3_DAILY_REQUEST_LIMIT=0
AI3_DDOS_IP_RPM=120
AI3_DDOS_MAX_CONCURRENT_PER_IP=20
AI3_MAX_REQUEST_BYTES=2000000
AI3_DATA_ENCRYPTION_KEY_FILE=/run/secrets/ai3_data_key

# Eigener Mailserver: lokal betrieben, keine externe SMTP-API.
# Bei öffentlicher Mail müssen Domain-DNS, PTR/rDNS und Port 25 funktionieren.
AI3_MAIL_ENABLED=1
AI3_MAIL_DOMAIN=
AI3_MAIL_HOST=mail.
AI3_MAIL_ADMIN=postmaster
AI3_MAILBOX_STORAGE=/data/mail
AI3_MAIL_MAX_MESSAGE_MB=25
AI3_MAIL_TLS=auto

# AI3 Own Verification — keine eID/EUDI/KYC-Abhängigkeit.
AI3_VERIFICATION_MAX_BYTES=8388608
AI3_VERIFICATION_RETENTION_DAYS=30

# AI3 private PKI
AI3_PKI_DIR=/data/pki

# Lokale KI / Ollama
AI3_MODEL=llama3.2:3b
AI3_OLLAMA_URL=http://ollama:11434
AI3_LLM_BASE_URL=http://ollama:11434/v1
AI3_LLM_API_KEY=
AI3_LLM_TIMEOUT=300
AI3_VLLM_URL=
AI3_LLAMACPP_URL=
AI3_BACKEND=ollama
AI3_BACKUP_DIR=/data/backups
