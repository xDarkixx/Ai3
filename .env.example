# Generate a long random value. Never commit the real .env file.
AI3_ADMIN_KEY=replace-with-a-long-random-admin-key

# Local OpenAI-compatible inference backend. Examples:
# Ollama: http://host.docker.internal:11434/v1
# vLLM:   http://host.docker.internal:8000/v1
AI3_LLM_BASE_URL=http://host.docker.internal:11434/v1
AI3_LLM_API_KEY=
AI3_LLM_TIMEOUT=300
