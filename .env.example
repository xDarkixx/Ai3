# Generate a long random value. Never commit the real .env file.
AI3_ADMIN_KEY=replace-with-a-long-random-admin-key

# Local model used by the bundled Ollama service.
# llama3.2:3b is about 2 GB and is a reasonable CPU-friendly default.
AI3_MODEL=llama3.2:3b

# AI3 talks to Ollama over the private Docker network.
AI3_LLM_BASE_URL=http://ollama:11434/v1
AI3_LLM_API_KEY=
AI3_LLM_TIMEOUT=300
