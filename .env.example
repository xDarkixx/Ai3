# AI3 — example configuration
# Lokale Inferenz benötigt keinen kostenpflichtigen KI-API-Anbieter.
# Hardware, Strom, Internet und eine optionale Domain sind davon getrennt.

AI3_ADMIN_KEY=replace-with-a-long-random-admin-key
AI3_ADMIN_PASSWORD=replace-with-a-strong-password
AI3_ADMIN_SESSION_HOURS=12
AI3_PUBLIC_BASE_URL=https://ai3.example.com

# Public registration. Set to 0 to require admin invitations.
AI3_PUBLIC_REGISTRATION=1
AI3_PRIVACY_MODE=1
AI3_ENABLE_ADVANCED_SECURITY=1
AI3_ACCESS_TOKEN_MINUTES=15
AI3_REFRESH_TOKEN_DAYS=30
AI3_RATE_LIMIT_RPM=0
AI3_DAILY_REQUEST_LIMIT=0

# DDoS/abuse protection
AI3_DDOS_IP_RPM=120
AI3_DDOS_MAX_CONCURRENT_PER_IP=20
AI3_MAX_REQUEST_BYTES=2000000

# Encryption key: generate a 32-byte random key and keep it outside git.
AI3_DATA_ENCRYPTION_KEY_FILE=/run/secrets/ai3_data_key

# Email verification / password recovery (optional but strongly recommended for public deployments)
AI3_SMTP_HOST=smtp.example.com
AI3_SMTP_PORT=587
AI3_SMTP_USER=ai3@example.com
AI3_SMTP_PASSWORD=replace-with-smtp-password
AI3_SMTP_FROM=AI3 <ai3@example.com>
AI3_EMAIL_VERIFY_HOURS=24
AI3_PASSWORD_RESET_MINUTES=30

# Identity: self-hosted EUDI verifier. No commercial KYC provider.
# The verifier/trust validator run as local Docker services.
# For real wallet traffic this URL must be publicly reachable over HTTPS.
AI3_EUDI_PUBLIC_URL=https://ai3.example.com/eudi
AI3_EUDI_VERIFIER_URL=http://eudi-verifier:8080

# Legacy German Online-Ausweis adapter (optional alternative).
AI3_IDENTITY_PROVIDER_URL=
AI3_IDENTITY_CALLBACK_SECRET=replace-with-random-callback-secret
AI3_EID_SERVER_URL=
AI3_EID_TC_TOKEN_URL=

# Local model / Ollama
AI3_MODEL=llama3.2:3b
AI3_OLLAMA_URL=http://ollama:11434
AI3_LLM_BASE_URL=http://ollama:11434/v1
AI3_LLM_API_KEY=
AI3_LLM_TIMEOUT=300
AI3_VLLM_URL=
AI3_LLAMACPP_URL=
AI3_BACKEND=ollama
AI3_BACKUP_DIR=/data/backups
